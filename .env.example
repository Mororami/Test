# Telegram 봇 (BotFather 에서 발급). 없으면 알림이 콘솔에만 출력됩니다.
TELEGRAM_BOT_TOKEN=
# 알림을 받을 채팅 ID. `python -m app chat-id` 로 찾을 수 있습니다.
TELEGRAM_CHAT_ID=

# (선택) 대시보드 바인딩 주소/포트. config.yaml 의 dashboard 항목보다 우선합니다.
# DASHBOARD_HOST=0.0.0.0
# DASHBOARD_PORT=8080

# (선택) 설정 파일 경로. 기본은 ./config.yaml
# KIMP_CONFIG=config.yaml

# 기존 Bithumb MCP 설정용 (docs/bithumb-mcp.md 참고). 이 프로젝트의 봇/대시보드에는 필요 없습니다.
# BITHUMB_ACCESS_KEY=
# BITHUMB_SECRET_KEY=
